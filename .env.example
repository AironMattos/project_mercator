# Banco local (docker-compose) usado em desenvolvimento
DATABASE_URL=postgresql+psycopg2://mercator:mercator@localhost:5432/mercator

# Banco hospedado (Supabase/Neon) usado em produção/piloto - preencher localmente em .env, nunca commitar
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>/<db>?sslmode=require

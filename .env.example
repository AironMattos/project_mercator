# Banco local (docker-compose) usado em desenvolvimento
DATABASE_URL=postgresql+psycopg2://mercator:mercator@localhost:5432/mercator

# Banco hospedado (Supabase/Neon) usado em produção/piloto - preencher localmente em .env, nunca commitar
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>/<db>?sslmode=require

# apps/api - origens extras liberadas no CORS, separadas por vírgula.
# http://localhost:3000 já é liberado por padrão pelo código; adicionar aqui
# a URL de produção do Vercel assim que existir (checkpoint 7d).
# CORS_ORIGINS=https://<projeto>.vercel.app

# tests/api - banco usado pelos testes automatizados da API (recriado do
# zero a cada execução). Aponta por padrão para mercator_test no mesmo
# Postgres local de DATABASE_URL; normalmente não precisa ser definida.
# TEST_DATABASE_URL=postgresql+psycopg2://mercator:mercator@localhost:5432/mercator_test

# pipelines/geocoding (checkpoint 9b) - caminho do Rscript.exe, usado só
# pela Etapa 1 (geocodebr) via subprocesso. R não é dependência do
# serviço principal, só do pipeline de batch. Default "Rscript" assume
# que está no PATH; nesta máquina não estava - path completo abaixo.
MERCATOR_RSCRIPT_PATH=C:/Program Files/R/R-4.6.1/bin/Rscript.exe
# Biblioteca de pacotes R do usuário (onde o geocodebr foi instalado,
# fora de Program Files por causa de permissão de escrita) - lido por
# geocode_batch.R via .libPaths(). Herdado do ambiente do processo Python
# (subprocess.run sem env= explícito já propaga isso).
MERCATOR_R_LIBS=C:/Users/Airon/Documents/R/win-library/4.6
